  xmlns="urn:dehsp:dictionary"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="urn:dehsp:dictionary Dictionary.xsd"
  version="1.1-3.8beta2"
>
